# Copy to .env and fill in real values. Never commit .env.
BOOKNEST_DB_URL=jdbc:postgresql://localhost:5432/booknest_db
BOOKNEST_DB_USERNAME=user
BOOKNEST_DB_NAME=booknest_db
BOOKNEST_DB_PASSWORD=

# SMTP account used to send registration codes
BOOKNEST_MAIL_HOST=smtp.gmail.com
BOOKNEST_MAIL_PORT=587
BOOKNEST_MAIL_USERNAME=
BOOKNEST_MAIL_PASSWORD=
BOOKNEST_MAIL_FROM=
